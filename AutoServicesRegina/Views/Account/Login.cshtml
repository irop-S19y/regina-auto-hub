<div class="d-flex justify-content-center align-items-center" style="height:80vh;">

    <div class="card shadow-lg p-4" style="width:400px; border-radius:15px;">

        <h3 class="text-center mb-4">Login</h3>

        <form asp-controller="Account" asp-action="Login" method="post">

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="name@example.com" minlength="8" maxlength="30" 
                required title="Email must be between 8 and 30 characters">
                 
                                  
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Password" minlength="6" maxlength="15" 
                required title="Password must be between 6 and 15 characters">
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" name="RememberMe">
                <label class="form-check-label">Remember me</label>
            </div>

            <button class="btn btn-primary w-100">Sign in</button>

        </form>

    </div>

</div>