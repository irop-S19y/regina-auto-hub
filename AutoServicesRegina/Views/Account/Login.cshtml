<div class="d-flex justify-content-center align-items-center" style="height:80vh;">

    <div style="width:400px;">

        <!-- ⭐ MESSAGE -->
        @if (Context.Request.Query["message"] == "login_required")
        {
            <div class="login-alert mb-3">
                <div class="icon">⭐</div>
                <div>
                    <h5>Want to leave a review?</h5>
                    <p>
                        Log in or create an account to rate this service and share your experience 💬
                    </p>
                </div>
            </div>
        }

        <div class="card shadow-lg p-4" style="border-radius:15px;">

            <h3 class="text-center mb-4">Login</h3>

            <form asp-controller="Account" asp-action="Login" method="post">

                <!-- 🔥 RETURN URL -->
                <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required />
                </div>

                <button class="btn btn-primary w-100">Sign in</button>

                <a href="/Account/ForgotPassword" style="display:block; margin-top:10px;">
                   Forgot password?
                 </a>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">
                    @ViewBag.Error
                </div>
            }

            <!-- 🔥 REGISTER BUTTON -->
            <div class="text-center mt-3">
                <p>
                    Don't have an account?
                    <a href="/Account/Register?message=login_required" class="btn btn-outline-warning btn-sm">
                        Create one
                    </a>
                </p>
            </div>

        </div>
    </div>
</div>

<!-- 🎨 STYLE -->
<style>
.login-alert {
    display: flex;
    gap: 12px;
    align-items: center;
    background: linear-gradient(135deg, #1f1f1f, #2c2c2c);
    color: #fff;
    padding: 12px 15px;
    border-radius: 10px;
    border-left: 4px solid #f5c542;
    box-shadow: 0 3px 10px rgba(0,0,0,0.2);
}

.login-alert .icon {
    font-size: 24px;
    color: #f5c542;
}

.login-alert h5 {
    margin: 0;
    font-size: 16px;
}

.login-alert p {
    margin: 0;
    font-size: 13px;
    color: #ddd;
}
</style>