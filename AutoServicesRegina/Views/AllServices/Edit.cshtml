@model AutoServicesRegina.Models.Service

<h2>Edit Service</h2>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Name</label>
        <input class="form-control" asp-for="Name">
    </div>

    <div class="mb-3">
        <label>Address</label>
        <input class="form-control" asp-for="Address">
    </div>

    <div class="mb-3">
        <label>City</label>
        <input class="form-control" asp-for="City">
    </div>

    <div class="mb-3">
        <label>Phone</label>
        <input class="form-control" asp-for="Phone">
    </div>

    <div class="mb-3">
        <label>Website</label>
        <input class="form-control" asp-for="Website">
    </div>

    <div class="mb-3">
        <label>Description</label>
        <input class="form-control" asp-for="Description">
    </div>

    <div class="mb-3">
        <label>Working Hours</label>
        <input class="form-control" asp-for="WorkingHours">
    </div>

    <div class="mb-3">
        <label>Image URL</label>
        <input class="form-control" asp-for="ImageUrl">
    </div>

    <button class="btn btn-success">Save</button>
</form>