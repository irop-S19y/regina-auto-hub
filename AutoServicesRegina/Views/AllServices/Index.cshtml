 
 @model List<AutoServicesRegina.Models.Service>
 List<AutoServicesRegina.Models

<h1>All Services</h1>


<div class="container">
    <h1 class="mb-4">All Services</h1>

    <a href="/AllServices/Add" class="btn btn-primary mb-4">Add Auto Service</a>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow">

                    <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;">
                    <div class="card-body">
                        <h5>@item.Name</h5>

                        <p>
                            📍 @item.Address <br />
                            📞 @item.Phone
                        </p>
                        <div class="rating" data-id="@item.Id">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star" data-value="@i">★</span>
                        }
                    </div>

                    <div>
                    <b>@item.Rating.ToString("0.0")</b>
                    <span>(@item.RatingCount)</span>
                    </div>

                        <a href="@item.Website" target="_blank" class="btn btn-primary">
                            Visit Website
                        </a>
                        <a href="/Comments/Service/@item.Id" class="btn btn-outline-secondary mt-2">
                          💬 Comments (@(item.Comments?.Count ?? 0))
                        </a>
                    </div>

                   </div>
                   </div>
        }
                  </div>
                 </div>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".rating").forEach(rating => {
                const serviceId = rating.dataset.id;

        rating.querySelectorAll(".star").forEach(star => {
            star.addEventListener("click", () => {
                const value = star.dataset.value;

                fetch('/AllServices/Rate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        serviceId: serviceId,
                        value: value
                    })
                })
                    .then(res => {
                    if (res.ok) location.reload();
                     else alert("Login required");
                 });
                });
                });
                });
                 });
              </script>
              <style>
                .star {
                    font-size: 20px;
                    cursor: pointer;
                    color: gray;
                }

                .star:hover {
                    color: gold;
                }
                </style>