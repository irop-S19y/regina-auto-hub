 
 @model List<AutoServicesRegina.Models.Service>
 List<AutoServicesRegina.Models

<h1>All Services</h1>


<div class="container">
    <h1 class="mb-4">All Services</h1>

    @if (User.IsInRole("Admin"))
    {
     <a href="/AllServices/Add" class="btn btn-primary mb-4">Add Auto Service</a>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow">

                    <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;">
                    <div class="card-body">
                        <h5>@item.Name</h5>

                     <p>
                        📍 
                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(item.Address)" 
                        target="_blank">
                            @item.Address
                        </a>
                        <br />
                        📞 @item.Phone
                    </p>
                      
                    <div class="rating" data-id="@item.Id" data-my-rating="@item.MyRating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star" data-value="@i">★</span>
                        }
                    </div> 
                    
                    <div>
                    <b>@item.Rating.ToString("0.0")</b>
                   <a href="/AllServices/Ratings/@item.Id">
                        (@item.RatingCount)
                   </a>
                    </div>
                     
            <a href="@item.Website" target="_blank" class="btn btn-primary">
                Visit Website
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a href="/AllServices/Edit/@item.Id" class="btn btn-warning btn-sm mt-2">Edit</a>

                <a href="/AllServices/Delete/@item.Id" class="btn btn-danger btn-sm mt-2">Delete</a>
            }
        
            </div>

            </div>
            </div>
                    }
            </div>
            </div>
               <div id="loginAlert" style="
                display:none;
                position:fixed;
                top:20px;
                left:50%;
                transform:translateX(-50%);
                z-index:9999;
                padding:12px 20px;
                border-radius:8px;
                font-weight:500;
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            ">
            </div>

            <script>
          document.addEventListener("DOMContentLoaded", function () {
          // Check if user is logged in
          const isAuthenticated = @((User?.Identity?.IsAuthenticated ?? false).ToString().ToLower());

          document.querySelectorAll(".rating").forEach(rating => {

          const serviceId = rating.dataset.id;
          const myRating = parseInt(rating.dataset.myRating) || 0;

          // paint the stars
          rating.querySelectorAll(".star").forEach(s => {
            s.style.color = s.dataset.value <= myRating ? "gold" : "lightgray";
         });
           // Add click event to stars
           rating.querySelectorAll(".star").forEach(star => {
            star.addEventListener("click", () => {
                 // Redirect guest users to login page
                if (!isAuthenticated) {

                const alertBox = document.getElementById("loginAlert");

                alertBox.className = "alert alert-warning text-center";
                alertBox.innerText = "Please login to leave a rating ⭐";
                alertBox.style.display = "block";

                const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);

                setTimeout(() => {
                    alertBox.style.display = "none";
                    window.location.href = `/Account/Login?message=login_required&returnUrl=${returnUrl}`;
                }, 1200);

                return;
                }
               
                const value = parseInt(star.dataset.value);

                // Send rating to server
                fetch('/AllServices/Rate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        serviceId: serviceId,
                        value: value
                    })
                })
                .then(res => {
                    if (res.status === 401) {
                        window.location.href = "/Account/Login";
                        return;
                    }

                    // Reload page after successful rating
                    if (res.ok) {
                        window.location.reload(); // 
                    }
                });
            });
        });

    });
});

        //cached star colors after page navigation
        window.addEventListener("pageshow", function () {
        document.querySelectorAll(".rating").forEach(rating => {

        const myRating = parseInt(rating.dataset.myRating) || 0;

        rating.querySelectorAll(".star").forEach(s => {
            s.style.color = s.dataset.value <= myRating ? "gold" : "lightgray";
        });

    });
});
         </script>
           
            
            <style>
            .star {
                font-size: 22px;
                cursor: pointer;
                color: lightgray;
                transition: 0.2s;
            }

            .star:hover {
                color: gold;
            }
            </style>
                                                