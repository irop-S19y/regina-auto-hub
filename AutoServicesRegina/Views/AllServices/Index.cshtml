 
 @model List<AutoServicesRegina.Models.Service>
 List<AutoServicesRegina.Models

<h1>All Services</h1>


<div class="container">
    <h1 class="mb-4">All Services</h1>

    <a href="/AllServices/Add" class="btn btn-primary mb-4">Add Auto Service</a>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow">

                    <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;">
                    <div class="card-body">
                        <h5>@item.Name</h5>

                        <p>
                            📍 @item.Address <br />
                            📞 @item.Phone
                        </p>
                      
                    <div class="rating" data-id="@item.Id">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star" data-value="@i">★</span>
                        }
                    </div> 
                    
                    <div>
                    <b>@item.Rating.ToString("0.0")</b>
                   <a href="/AllServices/Ratings/@item.Id">
                        (@item.RatingCount)
                   </a>
                    </div>
                     
            <a href="@item.Website" target="_blank" class="btn btn-primary">
                Visit Website
            </a>
        
            </div>

            </div>
            </div>
                    }
            </div>
            </div>
               
            <script>
             document.addEventListener("DOMContentLoaded", function () {

             const isAuthenticated = @(User?.Identity?.IsAuthenticated == true ? "true" : "false");

             document.querySelectorAll(".rating").forEach(rating => {
             const serviceId = rating.dataset.id;

             rating.querySelectorAll(".star").forEach(star => {
             star.addEventListener("click", () => {

                if (!isAuthenticated) {
                    window.location.href = "/Account/Login";
                    return;
                }

                const value = parseInt(star.dataset.value);

                fetch('/AllServices/Rate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        serviceId: serviceId,
                        value: value
                    })
                })
                .then(res => {
                    if (res.status === 401) {
                        window.location.href = "/Account/Login";
                        return;
                    }

                    if (res.ok) {
                        window.location.href = `/AllServices/Ratings/${serviceId}?rating=${value}`;
                    }
                })
                     .catch(err => console.log(err));

            });
        });
    });
});
           </script>
              
            <style>
            .star {
                font-size: 22px;
                cursor: pointer;
                color: lightgray;
                transition: 0.2s;
            }

            .star:hover {
                color: gold;
            }
            </style>
                                                