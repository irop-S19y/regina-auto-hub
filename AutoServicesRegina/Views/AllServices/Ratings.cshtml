@model AutoServicesRegina.Models.Service

<h2>@Model.Name - Ratings</h2>

<div style="margin-bottom:20px;">
    <h1>⭐ @ViewBag.Avg.ToString("0.0")</h1>
    <p>@ViewBag.Count reviews</p>

    <div class="star-filter">
        <a href="/AllServices/Ratings/@Model.Id?star=5"
           style="@(ViewBag.SelectedStar == 5 ? "font-weight:bold; color:#e0a800;" : "")">
            5 ⭐ — @ViewBag.Five
        </a>
    </div>

    <div class="star-filter">
        <a href="/AllServices/Ratings/@Model.Id?star=4"
           style="@(ViewBag.SelectedStar == 4 ? "font-weight:bold; color:#e0a800;" : "")">
            4 ⭐ — @ViewBag.Four
        </a>
    </div>

    <div class="star-filter">
        <a href="/AllServices/Ratings/@Model.Id?star=3"
           style="@(ViewBag.SelectedStar == 3 ? "font-weight:bold; color:#e0a800;" : "")">
            3 ⭐ — @ViewBag.Three
        </a>
    </div>

    <div class="star-filter">
        <a href="/AllServices/Ratings/@Model.Id?star=2"
           style="@(ViewBag.SelectedStar == 2 ? "font-weight:bold; color:#e0a800;" : "")">
            2 ⭐ — @ViewBag.Two
        </a>
    </div>

    <div class="star-filter">
        <a href="/AllServices/Ratings/@Model.Id?star=1"
           style="@(ViewBag.SelectedStar == 1 ? "font-weight:bold; color:#e0a800;" : "")">
            1 ⭐ — @ViewBag.One
        </a>
    </div>

    
            <h4>All reviews:</h4>

        @if (Model.Ratings.Any())
        {
            <ul>
            @foreach (var r in Model.Ratings)
            {
                var  comment = Model.Comments
                
                .FirstOrDefault(c => c.RatingId == r.Id);
                
                <li style="margin-bottom:15px;">
                    👤 <b>@r.User?.FirstName</b><br />

                    <span style="color:#e0a800;">
                        @(new string('★', r.Value))
                        @(new string('☆', 5 - r.Value))
                    </span>
                    <br />

                    💬 @(comment?.Text ?? "No comment")

                    <br />

                    <small style="color:gray;">
                        @(comment?.CreatedAt.ToString("dd MMM yyyy • HH:mm"))
                    </small>

                    <!-- 🔥 ADMIN BUTTONS -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div style="margin-top:5px; display:flex; gap:5px;">

                            <!-- DELETE RATING -->
                            <form method="post" action="/Admin/DeleteRating"
                                onsubmit="return confirm('Are you sure you want to delete this rating?');">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button class="btn btn-warning btn-sm">Delete Rating</button>
                            </form>

                            <!-- DELETE COMMENT -->
                            @if (comment != null)
                            {
                                <form method="post" action="/Admin/DeleteComment"
                                    onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                    <input type="hidden" name="id" value="@comment.Id" />
                                    <button class="btn btn-danger btn-sm">Delete Comment</button>
                                </form>
                            }

                        </div>
                    }

                </li>
            }
            </ul>
        }
        else
        {
            <p>No reviews yet</p>
        }


    <a href="/AllServices/Ratings/@Model.Id" class="btn btn-primary mt-2">
        Show all reviews
    </a>
     
     <hr />

    <h3>Leave a review</h3>

       @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div id="review-form">

        <!-- ⭐ Stars -->
        <div id="stars">
            <span class="star" data-value="1">★</span>
            <span class="star" data-value="2">★</span>
            <span class="star" data-value="3">★</span>
            <span class="star" data-value="4">★</span>
            <span class="star" data-value="5">★</span>
        </div>

        <!-- 💬 Comment -->
        <textarea id="commentText" class="form-control mt-2"
                  placeholder="Write your comment..."></textarea>

        <!-- Button -->
        <button id="submitReview" class="btn btn-primary mt-2">
            Submit
        </button>

        </div>
        }
        else
        {
        <p>
            🔒 <a href="/Account/Login">Login to leave a review</a>
        </p>
}
    <a href="/AllServices" class="back-btn mt-2">
    ← Back
    </a>

    <style>
    .star-filter a {
        color: #333;
        text-decoration: none;
    }

    .star-filter a:hover {
        color: #e0a800;
    }
    </style>

    <style>
    .back-btn {
    background: linear-gradient(135deg, #1f1f1f, #3a3a3a);
    color: #f5c542;
    padding: 8px 18px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid #f5c542;
    transition: all 0.25s ease;
    display: inline-block;
}

    .back-btn:hover {
    background: #f5c542;
    color: black;
    transform: translateX(-3px);
}
   </style>
    
    <script>
   
    let selectedRating = @ViewBag.MyRating;
     
    document.querySelectorAll("#stars .star").forEach(s => {
    s.style.color = s.dataset.value <= selectedRating ? "gold" : "gray";
    });

    // Check if review form exists
    if (document.getElementById("review-form")) {

    // Handle star selection
    document.querySelectorAll("#stars .star").forEach(star => {
        star.addEventListener("click", () => {
            selectedRating = star.dataset.value;

            // підсвітка
            document.querySelectorAll("#stars .star").forEach(s => {
                s.style.color = s.dataset.value <= selectedRating ? "gold" : "gray";
            });
        });
    });

         // Submit review
         document.getElementById("submitReview").addEventListener("click", () => {
        const text = document.getElementById("commentText").value;

        const isAuthenticated = @((User?.Identity?.IsAuthenticated ?? false).ToString().ToLower());
             
             // Redirect guest users to login
            if (!isAuthenticated) {
                alert("Login to leave a review 💬");

        const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);

                setTimeout(() => {
                    window.location.href = `/Account/Login?message=login_required&returnUrl=${returnUrl}`;
                }, 1000);

                return;
            }

        // Require rating selection
        if (selectedRating == 0) {
            alert("Please select rating");
            return;
        }
        
         // Send review to server
        fetch('/Reviews/Add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                serviceId: @Model.Id,
                value: selectedRating,
                text: text
            })
        })
        .then(res => {
            if (res.ok) {
                location.reload();
            }
            else if (res.status === 401) {
                window.location.href = "/Account/Login";
            }
        });
    });
}
     </script>

     <script>
             // Auto focus on textarea
            const textarea = document.getElementById("commentText");
            if (textarea) {
                textarea.focus();
            }
       </script>