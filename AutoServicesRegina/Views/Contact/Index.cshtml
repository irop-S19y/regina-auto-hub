@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-5">

<h1 class="text-center mb-4">Contact Us</h1>

<button onclick="history.back()" class="btn btn-dark">
    Back
</button>

<p class="text-center">
If you encounter any difficulties while using our platform or have ideas
for improving the website, please feel free to contact us.
</p>

<div class="row mt-5">

<div class="col-md-6">

<h4>Contact Information</h4>

<p><strong>Name:</strong> Ihor Syniak</p>

<p>
<strong>Email:</strong>
<a href="mailto:19970602irop@gmail.com">
    19970602irop@gmail.com
</a>
</p>

</div>


<div class="col-md-6">

<h4>Send Us a Message</h4>

<!-- ✅ FORM -->
<form asp-controller="Contact" asp-action="SendMessage" method="post">

<div class="mb-3">
<label class="form-label">Your Name</label>
<input type="text" name="name" class="form-control" required>
</div>

<div class="mb-3">
<label class="form-label">Email</label>
<input type="email" name="email" class="form-control" required>
</div>

<div class="mb-3">
<label class="form-label">Message</label>
<textarea name="message" class="form-control" rows="4" required></textarea>
</div>

<button class="btn btn-primary">
Send Message
</button>

</form>

<!-- ✅ SUCCESS MESSAGE -->
@if (ViewBag.Success != null)
{
    <div class="alert alert-success mt-3">
        @ViewBag.Success
    </div>
}

</div>

</div>

</div>