<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-4">Auto Hub Service in Regina</h1>
        <p class="lead">Find the best and trusted auto repair shops in Regina</p>
    </div>
    <hr class="mt-5" />

<div class="text-center mt-4 mb-5">
    <h4>Search Auto Services</h4>

    <form method="get" asp-controller="Home" asp-action="Index"
          class="d-flex justify-content-center mt-3">

        <input type="text"
               name="search"
               class="form-control w-50 me-2"
               placeholder="Enter auto service name..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

    </form>
   
    <div class="text-center mt-4">
    <a asp-controller="AllServisec" asp-action="Index" class="btn btn-outline-dark btn-lg">
        View All Services
    </a>

</div>


    <div class="row">

        <div class="col-md-4">
            <div class="card mb-4 shadow">
                <div class="card-body">
                    <h5 class="card-title">Regina Auto Repair</h5>
                    <p class="card-text">Engine • Brakes • Oil Change</p>
                    <p>123 Main St, Regina</p>
                    <a href="#" class="btn btn-success">View Details</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 shadow">
                <div class="card-body">
                    <h5 class="card-title">Quick Fix Garage</h5>
                    <p class="card-text">Tires • Alignments • Batteries</p>
                    <p>456 Albert St, Regina</p>
                    <a href="#" class="btn btn-success">View Details</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 shadow">
                <div class="card-body">
                    <h5 class="card-title">Speedy Tires Regina</h5>
                    <p class="card-text">New & Used Tires • Wheel Balancing</p>
                    <p>789 Broad St, Regina</p>
                    <a href="#" class="btn btn-success">View Details</a>
                </div>
            </div>
        </div>

    </div>

</div>
