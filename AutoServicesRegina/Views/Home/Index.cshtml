@using System.Linq
@model List<AutoServicesRegina.Models.Service>
<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-4">Auto Hub Service in Regina</h1>
        <p class="lead">Find the best and trusted auto repair shops in Regina</p>
    </div>
    <hr class="mt-5" />

    <div class="text-center mt-4 mb-5">
    <h4>Search Auto Services</h4>

        <form method="get" asp-controller="AllServices" asp-action="Index"
        class="d-flex justify-content-center mt-3">

        <input type="text"
               name="search"
               class="form-control w-50 me-2"
               placeholder="Enter auto service name..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

    </form>
   
    <div class="text-center mt-4 mb-5">
    <a asp-controller="AllServices" asp-action="Index" class="btn btn-outline-success btn-lg">
        View All Services
    </a>

</div>


    <div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4 shadow">
                <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>

                    <p class="card-text">
    📍 
                    <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(item.Address)" 
                    target="_blank">
                        @item.Address
                    </a>
                    </p>
                      
                      <div>
                    @{
                        var avg = item.Ratings.Any() ? item.Ratings.Average(r => r.Value) : 0;
                    }

                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(avg))
                        {
                            <span style="color:gold;">★</span>
                        }
                        else
                        {
                            <span style="color:lightgray;">★</span>
                        }
                    }

                    <span>(@avg.ToString("0.0"))</span>
                </div>
                   
                    <a href="@item.Website"
                     target="_blank"
                     class="btn btn-success">
                       Visit Website
                       </a>
                </div>
            </div>
        </div>
    }
</div>