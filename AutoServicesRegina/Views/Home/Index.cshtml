@using System.Linq
@model List<AutoServicesRegina.Models.Service>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1>🚗 Auto Hub Services</h1>
            <p>Find the best and most trusted auto repair shops in Regina, Saskatchewan</p>
        </div>
    </div>
</section>

<!-- Search Section -->
<div class="container">
    <div class="search-section">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <h4 class="text-center">🔍 Search Auto Services</h4>
                <form method="get" asp-controller="AllServices" asp-action="Index">
                    <div class="input-group input-group-lg">
                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Enter service name, type, or location..." />
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="AllServices" asp-action="Index" class="btn btn-outline-success btn-lg">
                        📋 View All Services
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Services -->
    <div class="mt-5 mb-5">
        <h2 class="text-center mb-4" style="color: var(--primary-color); font-weight: 700;">
            ⭐ Featured Services
        </h2>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name">

                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>

                            <p class="card-text text-muted small">
                                📍 <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(item.Address)"
                                      target="_blank" class="text-decoration-none">
                                    @item.Address
                                </a>
                                <br />
                                📞 @item.Phone
                            </p>

                            <!-- Rating Stars -->
                            <div class="mb-3">
                                @{
                                    var avg = item.Ratings.Any() ? item.Ratings.Average(r => r.Value) : 0;
                                }

                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(avg))
                                    {
                                        <span class="star" style="color: var(--accent-color);">★</span>
                                    }
                                    else
                                    {
                                        <span class="star" style="color: #ddd;">★</span>
                                    }
                                }
                                <small class="ms-2 text-muted">(@avg.ToString("0.0"))</small>
                            </div>

                            <a href="@item.Website"
                               target="_blank"
                               class="btn btn-success">
                                🌐 Visit Website
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>