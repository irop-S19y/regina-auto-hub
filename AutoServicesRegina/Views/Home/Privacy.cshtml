@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
.privacy-container {
    padding: 40px 0;
}

.privacy-content {
    margin: 0 auto;
    max-width: 760px;
    line-height: 1.8;
    color: #333;
}

.privacy-heading {
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
}

.privacy-heading h1 {
    font-size: 2.8rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
    color: #233d63;
}

.privacy-section h4 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    line-height: 1.3;
    color: #233d63;
}

.privacy-section p {
    margin-bottom: 1.25rem;
    color: #4b5160;
}

.privacy-section a {
    color: var(--secondary-color);
    text-decoration: none;
}

.privacy-section a:hover {
    text-decoration: underline;
}

.privacy-page {
    background: #f9fbff;
    border-left: 5px solid #d32f2f;
    border-radius: 20px;
    padding: 45px 40px;
}

@@media (max-width: 768px) {
    .privacy-page {
        padding: 30px 20px;
        border-radius: 16px;
    }
}
</style>

<div class="privacy-page">
    <div class="container">
        <div class="privacy-container">
            <div class="privacy-content">
                <div class="privacy-heading">
                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="privacy-section">
                    <p>
                        Auto Hub Services respects your privacy and is committed to protecting
                        your personal information.
                    </p>

                    <h4>Information We Collect</h4>
                    <p>
                        We may collect personal information such as your name, email address,
                        phone number, and any information you provide when contacting us.
                    </p>

                    <h4>How We Use Your Information</h4>
                    <p>
                        We use the collected information to respond to inquiries, improve our
                        services, and provide better support to our users.
                    </p>

                    <h4>Data Protection</h4>
                    <p>
                        We take reasonable measures to protect your information from
                        unauthorized access or disclosure.
                    </p>

                    <h4>Contact Us</h4>
                    <p>
                        If you have any questions about this Privacy Policy, please contact us
                        through our Contact Us page.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
